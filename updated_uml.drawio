<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="lNXSOhy1_LFKyN6kg08p">
    <mxGraphModel dx="2473" dy="1128" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml KiwiBank_Sprint2_UML\nskinparam classAttributeIconSize 0\nskinparam monochrome false\nskinparam roundcorner 10\nskinparam shadowing false\nskinparam packageStyle rectangle\n\ntitle KiwiBank System - Sprint 2 Updated Class Diagram (MVC &amp; Exceptions)\n\n&#39; ==========================================\n&#39; VIEW LAYER\n&#39; ==========================================\npackage \&quot;TASK3_GUI (View)\&quot; {\n    class Form1 {\n        - controller: CustomerController\n        + Form1()\n        - RefreshCustomerList(selectCustomerId: int?): void\n        - GetSelectedCustomerId(): int?\n        - UpdateAccountDisplay(): void\n        - btnAddCustomer_Click(sender: object, e: EventArgs): void\n        - btnUpdateCustomer_Click(sender: object, e: EventArgs): void\n        - btnDeleteCustomer_Click(sender: object, e: EventArgs): void\n        - btnClearCustomer_Click(sender: object, e: EventArgs): void\n        - btnDeposit_Click(sender: object, e: EventArgs): void\n        - btnWithdraw_Click(sender: object, e: EventArgs): void\n        - btnInterest_Click(sender: object, e: EventArgs): void\n        - LogActivity(message: string): void\n    }\n}\n\n&#39; ==========================================\n&#39; CONTROLLER LAYER\n&#39; ==========================================\npackage \&quot;BankSprint1 (Controller)\&quot; {\n    class CustomerController {\n        - customers: List&lt;Customer&gt;\n        + CustomerController()\n        - SeedInitialData(): void\n        + AddCustomer(name: string, contactDetails: string, isStaff: bool): Customer\n        + GetAllCustomers(): IReadOnlyList&lt;Customer&gt;\n        + GetCustomerById(customerNumber: int): Customer?\n        + UpdateCustomer(customerNumber: int, newName: string, newContactDetails: string): bool\n        + DeleteCustomer(customerNumber: int): bool\n        + GetAccount(customerNumber: int, accountIndex: int): Account?\n        + Deposit(customerNumber: int, accountIndex: int, amount: double, out status: string): bool\n        + Withdraw(customerNumber: int, accountIndex: int, amount: double, out status: string): bool\n        + CalculateInterest(customerNumber: int, accountIndex: int, out status: string): bool\n    }\n}\n\n&#39; ==========================================\n&#39; MODEL LAYER: CUSTOMER HIERARCHY\n&#39; ==========================================\npackage \&quot;BankSprint1 (Model - Customers)\&quot; {\n    abstract class Customer {\n        - customerNumber: int\n        - name: string\n        - contactDetails: string\n        - accounts: List&lt;Account&gt;\n        + CustomerNumber: int {get}\n        + Name: string {get; set;}\n        + ContactDetails: string {get; set;}\n        + Accounts: List&lt;Account&gt; {get;}\n        + Customer(custNum: int, custName: string, contact: string)\n        + UpdateDetails(newName: string, newContact: string): void\n        + {abstract} CalculateFee(baseFee: double): double\n        + ToString(): string\n    }\n\n    class BankStaff {\n        + BankStaff(customerNumber: int, name: string, contactDetails: string)\n        + CalculateFee(baseFee: double): double\n    }\n\n    class RegularCustomer {\n        + RegularCustomer(customerNumber: int, name: string, contactDetails: string)\n        + CalculateFee(baseFee: double): double\n    }\n}\n\n&#39; ==========================================\n&#39; MODEL LAYER: ACCOUNT HIERARCHY\n&#39; ==========================================\npackage \&quot;BankSprint1 (Model - Accounts)\&quot; {\n    abstract class Account {\n        # balance: double\n        # accountName: string\n        # lastTransactionStatus: string\n        - accountOwner: Customer\n        + Balance: double {get;}\n        + AccountName: string {get;}\n        + LastTransactionStatus: string {get;}\n        + AccountOwner: Customer {get;}\n        + Account(owner: Customer, accName: string, initialBalance: double)\n        + Deposit(amount: double): void\n        + {abstract} Withdraw(amount: double): void\n        + CalculateInterest(): void\n        + GetAccountInfo(): string\n    }\n\n    class EverydayAccount {\n        + EverydayAccount(owner: Customer, initialBalance: double)\n        + Withdraw(amount: double): void\n    }\n\n    class InvestmentAccount {\n        - interestRate: double = 0.05\n        - failedTransactionFee: double = 10.0\n        + InvestmentAccount(owner: Customer, initialBalance: double)\n        + Withdraw(amount: double): void\n        + CalculateInterest(): void\n    }\n\n    class OmniAccount {\n        - interestRate: double = 0.04\n        - overdraftLimit: double = 500.0\n        - failedTransactionFee: double = 10.0\n        - interestThreshold: double = 1000.0\n        + OmniAccount(owner: Customer, initialBalance: double)\n        + Withdraw(amount: double): void\n        + CalculateInterest(): void\n    }\n}\n\n&#39; ==========================================\n&#39; SYSTEM RELIABILITY: CUSTOM EXCEPTIONS\n&#39; ==========================================\npackage \&quot;BankSprint1 (Exceptions)\&quot; {\n    enum BankingErrorType {\n        GeneralError\n        InvalidAmount\n        InsufficientFunds\n        OverdraftExceeded\n    }\n\n    class BankingException {\n        + ErrorType: BankingErrorType {get;}\n        + AccountName: string {get;}\n        + BankingException(message: string, accountName: string, errorType: BankingErrorType)\n    }\n\n    class InsufficientFundsException {\n        + AttemptedAmount: double {get;}\n        + AvailableFunds: double {get;}\n        + InsufficientFundsException(message: string, accountName: string, attemptedAmount: double, availableFunds: double)\n    }\n\n    class OverdraftLimitExceededException {\n        + OverdraftLimit: double {get;}\n        + OverdraftLimitExceededException(message: string, accountName: string, attemptedAmount: double, availableFunds: double, overdraftLimit: double)\n    }\n}\n\n&#39; ==========================================\n&#39; RELATIONSHIPS &amp; ASSOCIATIONS\n&#39; ==========================================\n\n&#39; View to Controller\nForm1 ..&gt; CustomerController : \&quot;delegates UI actions\&quot;\n\n&#39; Controller to Model\nCustomerController \&quot;1\&quot; o-- \&quot;0..*\&quot; Customer : \&quot;manages (CRUD)\&quot;\nCustomerController ..&gt; Account : \&quot;mediates transactions\&quot;\n\n&#39; Customer Inheritance\nCustomer &lt;|-- BankStaff\nCustomer &lt;|-- RegularCustomer\n\n&#39; Customer &amp; Account Association\nCustomer \&quot;1\&quot; *-- \&quot;3\&quot; Account : \&quot;owns (accounts)\&quot;\nAccount --&gt; \&quot;1\&quot; Customer : \&quot;accountOwner\&quot;\n\n&#39; Account Inheritance\nAccount &lt;|-- EverydayAccount\nAccount &lt;|-- InvestmentAccount\nAccount &lt;|-- OmniAccount\n\n&#39; Exception Hierarchy\nBankingException &lt;|-- InsufficientFundsException\nInsufficientFundsException &lt;|-- OverdraftLimitExceededException\nBankingException --&gt; BankingErrorType : \&quot;categorized by\&quot;\n\n&#39; Account throws Exceptions\nAccount ..&gt; BankingException : \&quot;throws\&quot;\nCustomerController ..&gt; BankingException : \&quot;catches &amp; handles\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hzYMvM4_BIVuivj2Cami-999">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
